# SkillShare Mobile App Environment Configuration
# Copy this file to .env and adjust the values for your local or production environment.
# NOTE: Variables exposed to the React Native/Expo client bundle must start with EXPO_PUBLIC_

# PocketBase Server Base URL
# For local Android emulator, use: http://10.0.2.2:8090
# For local iOS simulator or Web, use: http://127.0.0.1:8090
# For physical mobile device on local Wi-Fi, use your local machine IP: http://192.168.x.x:8090
EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Google OAuth Client ID (public client ID for mobile OAuth redirect flow)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-placeholder.apps.googleusercontent.com

# Application environment
EXPO_PUBLIC_APP_ENV=development
